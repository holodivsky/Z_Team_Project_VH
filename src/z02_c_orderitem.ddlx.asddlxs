@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Position',
  typeNamePlural: 'Positionen',
  title: { type: #STANDARD, value: 'ItemNumber' }
}

annotate view Z02_C_ORDERITEM with
{
  @UI.hidden: true
  ItemUUID;

  @UI.hidden: true
  OrderUUID;

  @UI.hidden: true
  CustomerUUID;

  @UI.facet: [ { id: 'Position',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Positionsdaten',
                 position: 10 } ]

  @UI.lineItem: [ { position: 10, label: 'Pos.' } ]
  @UI.identification: [ { position: 10, label: 'Positionsnummer' } ]
  ItemNumber;

  @UI.lineItem: [ { position: 20, label: 'Produkt' } ]
  @UI.identification: [ { position: 20, label: 'Produkt' } ]
  ProductUUID;

  @UI.lineItem: [ { position: 30, label: 'Menge' } ]
  @UI.identification: [ { position: 30, label: 'Menge' } ]
  Quantity;

  @UI.identification: [ { position: 40, label: 'Einheit' } ]
  QuantityUnit;

  @UI.lineItem: [ { position: 40, label: 'Einzelpreis' } ]
  @UI.identification: [ { position: 50, label: 'Nettopreis' } ]
  NetPrice;

  @UI.lineItem: [ { position: 50, label: 'Positionswert' } ]
  @UI.identification: [ { position: 60, label: 'Positionswert' } ]
  ItemAmount;

  @UI.lineItem: [ { position: 60, label: 'Pfand' } ]
  @UI.identification: [ { position: 70, label: 'Pfandbetrag' } ]
  DepositTotal;

  @UI.identification: [ { position: 80, label: 'Währung' } ]
  Currency;

  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  LastChangedBy;
  @UI.hidden: true
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}