@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Auftrag',
  typeNamePlural: 'Aufträge',
  title: { type: #STANDARD, value: 'OrderID' }
}

annotate view Z02_C_ORDER with
{
  @UI.hidden: true
  OrderUUID;

  @UI.hidden: true
  CustomerUUID;

 @UI.facet: [ { id: 'Auftrag',
                 purpose: #STANDARD,
                 type: #IDENTIFICATION_REFERENCE,
                 label: 'Auftragsdaten',
                 position: 10 },
               { id: 'Positionen',
                 purpose: #STANDARD,
                 type: #LINEITEM_REFERENCE,
                 label: 'Positionen',
                 position: 20,
                 targetElement: '_Item' } ]

  @UI.lineItem: [ { position: 10, label: 'Auftragsnummer' } ]
  @UI.identification: [ { position: 10, label: 'Auftragsnummer' } ]
  OrderID;

  @UI.lineItem: [ { position: 20, label: 'Auftragsdatum' } ]
  @UI.identification: [ { position: 20, label: 'Auftragsdatum' } ]
  OrderDate;

  @UI.lineItem: [ { position: 30, label: 'Lieferdatum' } ]
  @UI.identification: [ { position: 30, label: 'Lieferdatum' } ]
  DeliveryDate;

  @UI.lineItem: [ { position: 40, label: 'Nettobetrag' } ]
  @UI.identification: [ { position: 40, label: 'Nettobetrag' } ]
  NetAmount;

  @UI.lineItem: [ { position: 50, label: 'Pfand' } ]
  @UI.identification: [ { position: 50, label: 'Pfandbetrag' } ]
  DepositTotal;

  @UI.identification: [ { position: 60, label: 'Währung' } ]
  Currency;

  @UI.lineItem: [ { position: 60, label: 'Status' } ]
  @UI.identification: [ { position: 70, label: 'Status' } ]
  OrderStatus;

  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  LastChangedBy;
  @UI.hidden: true
  LastChangedAt;
  @UI.hidden: true
  LocalLastChangedAt;
}